# Copy file này thành ".env" (cùng cấp index.js) rồi điền giá trị thật.
# ".env" đã nằm trong .gitignore — không commit giá trị thật lên GitHub.

# ── Database ──
MONGODB_URI=

# ── JWT ──
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# ── CORS (mặc định đã đúng cho dev local, chỉ cần đổi nếu deploy khác cổng) ──
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# ── Cổng server ──
PORT=8080

# ── Tài khoản ngân hàng nhận tiền (dùng cho QR nạp ví + QR thanh toán vé) ──
# BANK_CODE: mã ngân hàng theo chuẩn VietQR — có thể dùng mã BIN số (vd "970418"
# = BIDV) hoặc mã ngắn (vd "MBBank", "VCB"...). Xem danh sách đầy đủ tại
# https://vietqr.io
BANK_CODE=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_DISPLAY_NAME=

# Kiểu giao diện ảnh QR của VietQR quicklink: compact | compact2 | qr_only | print
VIETQR_TEMPLATE=compact2

# ── Giữ ghế tạm (phút) trước khi booking "pending" tự hết hạn ──
BOOKING_HOLD_DURATION_MINUTES=10

# ── Giá vé mặc định (VNĐ) khi 1 suất chiếu chưa set giá riêng ──
DEFAULT_PRICE_STANDARD=75000
DEFAULT_PRICE_VIP=95000
DEFAULT_PRICE_COUPLE=150000
